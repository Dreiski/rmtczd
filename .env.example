# Postgres connection string. Use Neon's *pooled* string (host contains -pooler).
# Copy this file to .env.local and fill it in.
#
# Leave unset to use the local PGlite database in .pglite/ instead — no setup
# required. Both `next dev` and the db:* scripts read .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: override where the local PGlite fallback stores its data.
# PGLITE_DIR=.pglite

# Secret used to sign the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Cloudflare R2 for image storage. Leave unset to store uploads on the local
# filesystem under .uploads/ instead — development only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public domain (r2.dev subdomain or a custom domain).
R2_PUBLIC_BASE_URL=
